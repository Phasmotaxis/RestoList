# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080

# Primary Relational Database (MySQL 8.0)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=eims_db
DB_USER=eims_user
DB_PASS=eims_password
DB_ROOT_PASSWORD=root_secure_password

# Offline Fallback Database (SQLite)
DB_SQLITE_PATH=/var/www/html/storage/fallback.sqlite
